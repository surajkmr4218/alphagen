# Database (psycopg v3 driver string; docker-compose overrides host to `db` in-network).
# The app connects as `alphagen_app`, a NOSUPERUSER role, so Postgres row-level security
# actually enforces (superusers bypass RLS). Create it once as the bootstrap superuser —
# see README "Getting started". The `app`/`app` role is only for bootstrap.
# APP_DB_PASSWORD is read by docker-compose to build the in-network DATABASE_URL;
# repeat the same password inline in DATABASE_URL below (dotenv does not interpolate).
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://alphagen_app:<password>@localhost:5432/alphagen

# LLM + market data
GEMINI_API_KEY=
FMP_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (403s without one)
SEC_USER_AGENT="AlphaGen your-name your@email.com"

# Auth + token encryption
FERNET_KEY=            # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLERK_JWKS_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Robinhood agentic trading account
ROBINHOOD_ACCOUNT_NUMBER=

# Tenant key for the seeded demo account (scripts/seed_demo.py)
DEMO_USER_ID=demo

# CORS Allowed Orgins (local dev)
ALLOWED_ORIGINS=
